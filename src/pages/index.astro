---
/**
 * Homepage. Real content only: every section hides itself until HCC's data exists.
 * The annotated sample-data version lives at /preview/homepage/.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomePage from '@/components/home/HomePage.astro';
import { home } from '@/lib/home';
import { organizationLd, websiteLd } from '@/lib/schema';
---

<BaseLayout title={home.seo.title} rawTitle description={home.seo.description} headerOverlay jsonLd={[organizationLd(Astro.site!), websiteLd(Astro.site!)]}>
  <HomePage />
</BaseLayout>
