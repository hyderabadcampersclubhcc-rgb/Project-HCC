---
/**
 * /trips/compare/?ids=a,b,c: side-by-side comparison of up to 3 trips (noindex).
 * Static page: a compact data set for every live trip is embedded; the browser renders
 * the selected columns from ?ids= (or the saved compare tray).
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/content/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import { getTrips, toneFor } from '@/lib/catalog';
import { inr, dateLong, durationLabel, bestMonthsLabel } from '@/lib/format';

const showSamples = import.meta.env.PUBLIC_SHOW_SAMPLES === 'true';
const trips = await getTrips();
const destinations = new Map((await getCollection('destinations')).filter((d) => showSamples || !d.data.sample).map((d) => [d.id, d.data]));
const WASH: Record<string, string> = { attached: 'Attached', shared: 'Shared', common: 'Common' };

const data = await Promise.all(
  trips.map(async (t) => {
    const o = t.primary;
    const d = t.data;
    const img = d.heroImage ? await getImage({ src: d.heroImage, width: 480, height: 300, fit: 'cover', format: 'webp' }) : null;
    const dest = destinations.get(d.destinations[0].id);
    return {
      id: t.id,
      title: d.title,
      url: o.url,
      img: img?.src ?? null,
      tone: toneFor(d),
      rows: {
        price: o.fromPrice != null ? `${inr(o.fromPrice)}${o.fromOriginalPrice ? ` (was ${inr(o.fromOriginalPrice)})` : ''}` : 'On request',
        duration: durationLabel(d.durationNights, d.durationDays),
        next: o.next ? `${dateLong(o.next.start)}${o.bookable.length > 1 ? ` · ${o.bookable.length} dates` : ''}` : (d.recurrence ?? 'Dates on request'),
        from: t.origins.map((x) => x.label).join(', '),
        route: t.destinationNames.join(' → '),
        travel: d.transportOptions.map((x) => x.label).join(' / '),
        stay: d.stays.map((s) => `${s.type}${s.washroom ? ` · ${WASH[s.washroom]} washroom` : ''}`).join('; ') || '—',
        rooms: d.stayOptions.map((s) => s.label).join(', '),
        difficulty: d.difficulty[0].toUpperCase() + d.difficulty.slice(1),
        group: d.groupSize ? `${d.groupSize.min}–${d.groupSize.max} people` : '—',
        best: bestMonthsLabel(dest?.bestMonths ?? []) || '—',
        included: d.inclusions.map((i) => i.cardLabel ?? i.text).slice(0, 6).join(', ') || '—',
        excluded: d.exclusions.slice(0, 4).join(', ') || '—',
        advance: d.advanceAmount != null ? `${inr(d.advanceAmount)} per person` : '—',
      },
    };
  }),
);

const ROWS: [string, string][] = [
  ['price', 'From (per person)'],
  ['duration', 'Duration'],
  ['next', 'Next departure'],
  ['from', 'Departs from'],
  ['route', 'Route'],
  ['travel', 'Travel'],
  ['stay', 'Stay'],
  ['rooms', 'Room sharing'],
  ['difficulty', 'Difficulty'],
  ['group', 'Group size'],
  ['best', 'Best time'],
  ['included', 'Included'],
  ['excluded', 'Not included'],
  ['advance', 'Advance to reserve'],
];
---

<BaseLayout title="Compare trips" description="Compare HCC trips side by side: price, dates, travel, stays and inclusions." noindex bodyClass="is-compare-page">
  <section class="section cmp" data-compare-page>
    <div class="container">
      <Breadcrumbs items={[{ label: 'Trips', href: '/trips/' }, { label: 'Compare' }]} />
      <h1 class="cmp__title">Compare trips</h1>
      <p class="muted cmp__sub" data-cmp-sub>Side by side: price, dates, travel, stays and what's included.</p>

      <div class="cmp__empty" data-cmp-empty hidden>
        <p>Pick 2–3 trips to compare. Tap <b>Compare</b> on any trip card.</p>
        <Button href="/trips/" iconRight="arrow">Browse trips</Button>
      </div>

      <div class="cmp__wrap" data-cmp-wrap hidden>
        <table class="cmp__table">
          <thead><tr data-cmp-head><th scope="col" class="sr-only">Detail</th></tr></thead>
          <tbody data-cmp-body></tbody>
        </table>
      </div>
    </div>
  </section>
  <script type="application/json" data-cmp-data set:html={JSON.stringify({ trips: data, rows: ROWS }).replace(/</g, '\\u003c')} />
</BaseLayout>

<script>
  import { getCompare, setCompare, MAX_COMPARE } from '@/scripts/compare';
  import { track } from '@/scripts/analytics';

  interface T {
    id: string;
    title: string;
    url: string;
    img: string | null;
    tone: string;
    rows: Record<string, string>;
  }
  const raw = JSON.parse(document.querySelector('[data-cmp-data]')!.textContent!) as { trips: T[]; rows: [string, string][] };
  const byId = new Map(raw.trips.map((t) => [t.id, t]));
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  const fromUrl = (new URLSearchParams(location.search).get('ids') ?? '').split(',').filter(Boolean);
  if (fromUrl.length) setCompare(fromUrl.filter((id) => byId.has(id)));

  const render = () => {
    const ids = getCompare().filter((id) => byId.has(id)).slice(0, MAX_COMPARE);
    const trips = ids.map((id) => byId.get(id)!);
    document.querySelector<HTMLElement>('[data-cmp-empty]')!.hidden = trips.length >= 2;
    document.querySelector<HTMLElement>('[data-cmp-wrap]')!.hidden = trips.length < 1;
    document.querySelector('[data-cmp-sub]')!.textContent = trips.length ? `Comparing ${trips.map((t) => t.title).join(', ')}.` : 'Side by side: price, dates, travel, stays and what’s included.';

    const head = document.querySelector('[data-cmp-head]')!;
    head.innerHTML =
      '<th scope="col" class="sr-only">Detail</th>' +
      trips
        .map(
          (t) => `<th scope="col" class="cmp__trip">
            <div class="cmp__img ${t.img ? '' : `ph ph--${esc(t.tone)}`}">${t.img ? `<img src="${esc(t.img)}" alt="" width="480" height="300" loading="lazy">` : ''}</div>
            <a href="${esc(t.url)}" class="cmp__name">${esc(t.title)}</a>
            <div class="cmp__acts"><a class="btn btn--primary btn--sm" href="${esc(t.url)}">View Dates</a>
            <button type="button" class="btn btn--text cmp__rm" data-cmp-remove="${esc(t.id)}">Remove</button></div>
          </th>`,
        )
        .join('');
    document.querySelector('[data-cmp-body]')!.innerHTML = raw.rows
      .map(([key, label]) => `<tr><th scope="row">${esc(label)}</th>${trips.map((t) => `<td>${esc(t.rows[key] ?? '—')}</td>`).join('')}</tr>`)
      .join('');
  };

  render();
  if (getCompare().length >= 2) track('compare_trips', { trip_ids: getCompare().join(','), cta_location: 'compare_page' });
  window.addEventListener('hcc:compare', render);
  document.addEventListener('click', (e) => {
    const rm = (e.target as Element).closest<HTMLElement>('[data-cmp-remove]');
    if (rm) {
      setCompare(getCompare().filter((id) => id !== rm.dataset.cmpRemove));
      history.replaceState(null, '', `?ids=${getCompare().join(',')}`);
    }
  });
</script>

<style>
  .cmp__title {
    margin: var(--s-3) 0 var(--s-2);
    font-size: var(--fs-h1);
  }
  .cmp__sub {
    margin-bottom: var(--s-6);
  }
  .cmp__empty {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
    padding: var(--s-8);
    background: var(--surface);
    border: 1px dashed var(--line-strong);
    border-radius: var(--r-xl);
  }
  .cmp__wrap {
    overflow-x: auto;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
  }
  .cmp__table {
    width: 100%;
    min-width: 640px;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
    font-size: 0.875rem;
  }
  .cmp__table :global(th),
  .cmp__table :global(td) {
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .cmp__table :global(tbody th) {
    width: 112px;
    font-weight: 600;
    color: var(--text-2);
    position: sticky;
    left: 0;
    background: var(--bg);
  }
  .cmp__table :global(.cmp__trip) {
    vertical-align: bottom;
    border-bottom: 0;
  }
  .cmp__table :global(.cmp__img) {
    aspect-ratio: 16 / 10;
    margin-bottom: 10px;
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .cmp__table :global(.cmp__img img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cmp__table :global(.cmp__name) {
    display: block;
    margin-bottom: 10px;
    font: 700 1.0625rem / 1.25 var(--font-display);
    text-decoration: none;
  }
  .cmp__table :global(.cmp__acts) {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cmp__table :global(.cmp__rm) {
    font-size: 0.8125rem;
  }
  @media (min-width: 768px) {
    .cmp__table :global(tbody th) {
      width: 170px;
    }
  }
  .cmp__table :global(tbody tr:first-child td) {
    font: 800 1.0625rem / 1.2 var(--font-display);
  }
</style>
