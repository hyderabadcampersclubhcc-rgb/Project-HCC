---
/** Travel guide card. */
import type { ImageMetadata } from 'astro';
import Photo, { type Tone } from '@/components/ui/Photo.astro';

interface Props {
  title: string;
  href: string;
  excerpt?: string;
  category?: string;
  date?: string; // YYYY-MM-DD (updated date preferred)
  readMinutes?: number;
  image?: ImageMetadata;
  imageAlt?: string;
  tone?: Tone;
  headingLevel?: 'h3' | 'h4';
}

const { title, href, excerpt, category, date, readMinutes, image, imageAlt, tone = 'hills', headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const dateLabel = date
  ? new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`))
  : null;
---

<article class="bcard">
  <div class="bcard__media">
    <Photo src={image} alt={imageAlt ?? ''} tone={tone} sizes="(min-width: 1024px) 33vw, 90vw" widths={[360, 540, 720]} />
  </div>
  <div class="bcard__body">
    {category && <p class="overline">{category}</p>}
    <H class="bcard__title"><a href={href}>{title}</a></H>
    {excerpt && <p class="bcard__excerpt">{excerpt}</p>}
    {
      (dateLabel || readMinutes) && (
        <p class="bcard__meta">
          {dateLabel && <time datetime={date}>Updated {dateLabel}</time>}
          {dateLabel && readMinutes && <span aria-hidden="true">·</span>}
          {readMinutes && <span>{readMinutes} min read</span>}
        </p>
      )
    }
  </div>
</article>

<style>
  .bcard {
    position: relative;
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .bcard__media {
    aspect-ratio: 16 / 10;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--surface-2);
  }
  .bcard__media :global(.photo) {
    transition: transform var(--t-slow) var(--ease);
  }
  @media (hover: hover) {
    .bcard:hover .bcard__media :global(.photo) {
      transform: scale(1.03);
    }
    .bcard:hover .bcard__title a {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }
  .bcard__body {
    display: grid;
    gap: 6px;
  }
  .bcard__title {
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .bcard__title a {
    text-decoration: none;
  }
  .bcard__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .bcard__excerpt {
    font-size: 0.875rem;
    color: var(--text-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bcard__meta {
    display: flex;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--text-3);
  }
</style>
