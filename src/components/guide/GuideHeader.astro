---
/** Guide title block: breadcrumbs, category, H1, author, updated date (E-E-A-T), read time. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Breadcrumbs from '@/components/content/Breadcrumbs.astro';

interface Props {
  title: string;
  category: string;
  categoryHref?: string;
  authorName: string;
  authorPhoto?: ImageMetadata;
  published: string; // YYYY-MM-DD
  updated?: string;
  readMinutes: number;
}

const { title, category, categoryHref, authorName, authorPhoto, published, updated, readMinutes } = Astro.props;
const fmt = (iso: string) => new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${iso}T00:00:00Z`));
const shown = updated && updated !== published ? updated : published;
---

<header class="ghead">
  <Breadcrumbs items={[{ label: 'Travel guides', href: '/travel-guides/' }, ...(categoryHref ? [{ label: category, href: categoryHref }] : []), { label: title }]} />
  <p class="overline">{category}</p>
  <h1 class="ghead__title">{title}</h1>
  <p class="ghead__meta">
    {authorPhoto ? <Image src={authorPhoto} alt="" width={64} height={64} class="ghead__avatar" /> : <span class="ghead__avatar ghead__avatar--i" aria-hidden="true">{authorName[0]}</span>}
    <span>
      By <b>{authorName}</b> · {updated && updated !== published ? 'Updated' : 'Published'} <time datetime={shown}>{fmt(shown)}</time> · {readMinutes} min read
    </span>
  </p>
</header>

<style>
  .ghead {
    display: grid;
    gap: var(--s-3);
  }
  .ghead__title {
    font-size: var(--fs-h1);
    line-height: 1.1;
    max-width: 22ch;
  }
  .ghead__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.875rem;
    color: var(--text-2);
  }
  .ghead__meta b {
    color: var(--ink-900);
  }
  .ghead__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }
  .ghead__avatar--i {
    display: grid;
    place-items: center;
    background: var(--forest-100);
    color: var(--forest-700);
    font: 700 0.9rem / 1 var(--font-display);
  }
</style>
