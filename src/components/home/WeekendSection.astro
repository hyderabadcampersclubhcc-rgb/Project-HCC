---
/**
 * Weekend trips by departure city: the homepage's local-SEO block. One panel per city
 * ([data-city-panel], switched by CitySwitch): trips, a planner table and a sentence linking the
 * destination pages. Each panel hands authority to its owner city page
 * (/weekend-trips-from-hyderabad/, /weekend-trips-from-bangalore/) instead of competing with it.
 */
import { getCollection } from 'astro:content';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import TripCard from '@/components/trip/TripCard.astro';
import Button from '@/components/ui/Button.astro';
import PlannerTable from '@/components/listing/PlannerTable.astro';
import { getTrips, destinationUrl } from '@/lib/catalog';
import { home } from '@/lib/home';

interface Props {
  catalog?: { samples?: boolean; today?: string };
  max?: number;
}

const { catalog = {}, max = 6 } = Astro.props;
const all = (await getTrips(catalog)).filter((t) => t.data.tripTypes.includes('weekend'));
const destinations = new Map((await getCollection('destinations')).map((d) => [d.id, d.data]));

const CITIES = [
  { city: 'hyderabad', label: 'Hyderabad', title: home.weekend.title, intro: home.weekend.intro, href: '/weekend-trips-from-hyderabad/' },
  { city: 'bangalore', label: 'Bangalore', title: 'Weekend trips from Bangalore', intro: 'Friday departures from Bangalore to the hills, the coast and tea country.', href: '/weekend-trips-from-bangalore/' },
];
const panels = CITIES.map((c) => {
  const trips = all.filter((t) => t.origins.some((o) => o.city === c.city)).slice(0, max);
  // Unique destinations in trip order, for the linked intro sentence.
  const destIds = [...new Set(trips.flatMap((t) => t.data.destinations.map((d) => d.id)))];
  const linked = destIds.slice(0, 7).map((id) => ({ id, name: destinations.get(id)?.name ?? id }));
  return { ...c, trips, destIds, linked };
}).filter((p) => p.trips.length > 0);
---

{
  panels.map((p) => (
    <section class="section wkd" aria-labelledby={`wkd-title-${p.city}`} data-city-panel={p.city}>
      <div class="container">
        <SectionHeader id={`wkd-title-${p.city}`} title={p.title}>
          <Button variant="text" href={p.href} iconRight="arrow">
            All weekend trips
          </Button>
        </SectionHeader>

        <p class="wkd__intro">
          {p.intro}{' '}
          {p.linked.length > 1 && (
            <>
              Join our organised group trips to{' '}
              {p.linked.map((d, i) => (
                <>
                  <a href={destinationUrl(d.id)}>{d.name}</a>
                  {i < p.linked.length - 2 ? ', ' : i === p.linked.length - 2 ? ' and ' : ''}
                </>
              ))}
              {p.destIds.length > p.linked.length ? ' and more.' : '.'}
            </>
          )}
        </p>

        <div class="rail rail--grid wkd__rail" style="--rail-cols:3">
          {p.trips.map((t, i) => (
            <TripCard trip={t} origin={p.city} index={i} listName={`home_weekend_${p.city}`} />
          ))}
        </div>

        <div class="wkd__planner">
          <PlannerTable trips={p.trips} origin={p.city} title={`Weekend getaway planner: from ${p.label}`} headingLevel="h3" />
        </div>

        <div class="wkd__cta">
          <Button href={p.href} variant="secondary" iconRight="arrow">
            Explore Weekend Trips from {p.label}
          </Button>
        </div>
      </div>
    </section>
  ))
}

<style>
  .wkd__intro {
    max-width: 70ch;
    margin: calc(-1 * var(--s-2)) 0 var(--s-6);
    color: var(--ink-700);
    font-size: 1.0625rem;
  }
  .wkd__intro a {
    color: var(--link);
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .wkd__planner {
    margin-top: var(--s-10);
  }
  .wkd__cta {
    margin-top: var(--s-6);
  }
</style>
