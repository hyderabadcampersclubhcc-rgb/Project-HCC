---
/**
 * "Weekend trips from Hyderabad": the homepage's local-SEO block. Shows trips (not
 * dates, which Upcoming already covers), a planner table generated from trip data, and a
 * data-generated sentence that links each destination page. It hands authority to the
 * owner page /weekend-trips-from-hyderabad/ (intent map §9) instead of competing with it.
 */
import { getCollection } from 'astro:content';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import TripCard from '@/components/trip/TripCard.astro';
import Button from '@/components/ui/Button.astro';
import { getTrips, destinationUrl } from '@/lib/catalog';
import { inr, durationLabel, bestMonthsLabel } from '@/lib/format';
import { home } from '@/lib/home';

interface Props {
  catalog?: { samples?: boolean; today?: string };
  max?: number;
}

const { catalog = {}, max = 6 } = Astro.props;
const trips = (await getTrips(catalog)).filter((t) => t.data.tripTypes.includes('weekend')).slice(0, max);
const destinations = new Map((await getCollection('destinations')).map((d) => [d.id, d.data]));

// Unique destinations across weekend trips, in trip order, for the linked intro sentence.
const destIds = [...new Set(trips.flatMap((t) => t.data.destinations.map((d) => d.id)))];
const linked = destIds.slice(0, 7).map((id) => ({ id, name: destinations.get(id)?.name ?? id }));

const rows = trips.map((t) => {
  const firstDest = destinations.get(t.data.destinations[0].id);
  return {
    trip: t,
    travel: t.data.transportOptions[0].label,
    duration: durationLabel(t.data.durationNights, t.data.durationDays),
    best: bestMonthsLabel(firstDest?.bestMonths ?? []),
    from: t.primary.fromPrice,
  };
});
---

{
  trips.length > 0 && (
    <section class="section wkd" aria-labelledby="wkd-title">
      <div class="container">
        <SectionHeader id="wkd-title" title={home.weekend.title}>
          <Button variant="text" href="/weekend-trips-from-hyderabad/" iconRight="arrow">
            All weekend trips
          </Button>
        </SectionHeader>

        <p class="wkd__intro">
          {home.weekend.intro}{' '}
          {linked.length > 1 && (
            <>
              Join our organised group trips to{' '}
              {linked.map((d, i) => (
                <>
                  <a href={destinationUrl(d.id)}>{d.name}</a>
                  {i < linked.length - 2 ? ', ' : i === linked.length - 2 ? ' and ' : ''}
                </>
              ))}
              {destIds.length > linked.length ? ' and more.' : '.'}
            </>
          )}
        </p>

        <div class="rail rail--grid wkd__rail" style="--rail-cols:3">
          {trips.map((t, i) => (
            <TripCard trip={t} index={i} listName="home_weekend" />
          ))}
        </div>

        <div class="wkd__planner">
          <h3 class="wkd__h3">Weekend getaway planner</h3>
          <div class="wkd__table-wrap">
            <table class="wkd__table">
              <thead>
                <tr>
                  <th scope="col">Trip</th>
                  <th scope="col">Getting there</th>
                  <th scope="col">Length</th>
                  <th scope="col">Best time</th>
                  <th scope="col">From</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr>
                    <th scope="row">
                      <a href={r.trip.url}>{r.trip.data.title}</a>
                    </th>
                    <td>{r.travel}</td>
                    <td>{r.duration}</td>
                    <td>{r.best || '—'}</td>
                    <td class="num">{r.from != null ? inr(r.from) : 'On request'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div class="wkd__cta">
          <Button href="/weekend-trips-from-hyderabad/" variant="secondary" iconRight="arrow">
            Explore Weekend Trips from Hyderabad
          </Button>
        </div>
      </div>
    </section>
  )
}

<style>
  .wkd__intro {
    max-width: 70ch;
    margin: calc(-1 * var(--s-2)) 0 var(--s-6);
    color: var(--ink-700);
    font-size: 1.0625rem;
  }
  .wkd__intro a {
    color: var(--link);
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .wkd__planner {
    margin-top: var(--s-10);
  }
  .wkd__h3 {
    margin-bottom: var(--s-3);
    font-size: var(--fs-h3);
  }
  .wkd__table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }
  .wkd__table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .wkd__table th,
  .wkd__table td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    white-space: nowrap;
  }
  .wkd__table thead th {
    background: var(--surface-2);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .wkd__table tbody tr:last-child > * {
    border-bottom: 0;
  }
  .wkd__table tbody th a {
    font-weight: 600;
    text-decoration: none;
  }
  .wkd__table tbody th a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .wkd__cta {
    margin-top: var(--s-6);
  }
</style>
