---
/**
 * Responsive photo. With a real image: AVIF/WebP <picture>, explicit dimensions,
 * lazy by default (pass `eager` for the LCP image). Without one: a branded
 * landscape placeholder, so missing photos never break a layout.
 * The element fills its parent; the parent controls aspect ratio.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

export type Tone = 'hills' | 'beach' | 'dusk' | 'snow' | 'forest' | 'camp' | 'coffee';

interface Props {
  src?: ImageMetadata | null;
  alt: string;
  tone?: Tone;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  /** Show a small "PHOTO · …" caption on placeholders (style guide only). */
  label?: string;
  class?: string;
}

const {
  src,
  alt,
  tone = 'hills',
  widths = [360, 540, 720, 960, 1280],
  sizes = '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 90vw',
  eager = false,
  label,
  class: className,
} = Astro.props;
---

{
  src ? (
    <Picture
      src={src}
      alt={alt}
      widths={widths.filter((w) => w <= src.width)}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding={eager ? 'sync' : 'async'}
      class:list={['photo', className]}
      pictureAttributes={{ class: 'photo-wrap' }}
    />
  ) : (
    <div class:list={['photo', 'ph', `ph--${tone}`, className]} role="img" aria-label={alt}>
      {label && <span class="ph__label">Photo · {label}</span>}
    </div>
  )
}

<style>
  :global(.photo-wrap) {
    display: contents;
  }
  .photo,
  :global(img.photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
