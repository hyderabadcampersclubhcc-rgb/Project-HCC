export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  label?: string;
  class?: string;
  filled?: boolean;
}

const { name, label, class: className, filled = false } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  style={filled ? 'fill:currentColor;stroke:none' : undefined}
  set:html={ICONS[name]}
/>
