---
/**
 * Official HCC logo (circular badge, src/assets/brand/hcc-logo.png, supplied by HCC Oct 2026).
 * The source file is used unchanged; the pipeline makes 1×/2×/3× WebP copies for sharp
 * rendering, and CSS rounds off the square image's black corners. The badge already carries
 * "HCC" and "Hyderabad Campers Club", so there is no separate text wordmark (no duplicate text):
 * the image's alt text is the link's accessible name.
 */
import { Image } from 'astro:assets';
import logo from '@/assets/brand/hcc-logo.png';

interface Props {
  /** Kept for existing call sites; the badge reads the same on light and dark backgrounds. */
  tone?: 'dark' | 'light';
  /** Kept for existing call sites (the name is part of the badge). */
  showName?: boolean;
  href?: string | null;
  /** Display size in CSS px (the badge is square). */
  size?: number;
  /** Load immediately (header) instead of lazily (footer, menus). */
  eager?: boolean;
  class?: string;
}

const { tone = 'dark', href = '/', size = 52, eager = false, class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag href={href ?? undefined} class:list={['logo', `logo--${tone}`, className]} style={`--logo-size:${size}px`}>
  <Image
    src={logo}
    alt="Hyderabad Campers Club (HCC) logo"
    width={size}
    height={size}
    densities={[1, 2, 3]}
    format="webp"
    quality={90}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    class="logo__img"
  />
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    flex: none;
  }
  .logo__img {
    display: block;
    width: var(--logo-size);
    height: var(--logo-size);
    border-radius: 50%;
  }
  .logo:focus-visible {
    outline: 2px solid var(--marigold-500);
    outline-offset: 3px;
    border-radius: 50%;
  }
</style>
