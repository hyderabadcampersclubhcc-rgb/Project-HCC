---
/**
 * Per-page SEO head: title, description, canonical (always the clean path, so
 * campaign parameters never create duplicates), robots, Open Graph, X/Twitter, JSON-LD.
 */
import { settings } from '@/lib/settings';

export interface SeoProps {
  title: string;
  description: string;
  /** Use `title` verbatim instead of appending " | HCC" (also skipped when it would push the title past 65 chars). */
  rawTitle?: boolean;
  /** Path override for canonical, e.g. when a page is reachable at several URLs. */
  canonicalPath?: string;
  noindex?: boolean;
  ogImage?: string; // absolute or root-relative URL
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, rawTitle = false, canonicalPath, noindex = false, ogImage, ogImageAlt, ogType = 'website', jsonLd } =
  Astro.props as SeoProps;

// Safety net: pages are noindex unless the build sets PUBLIC_ALLOW_INDEXING=true, which only the
// production deploy does. Local, staging and preview builds can never be indexed by accident.
const indexingAllowed = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true';
const robotsNoindex = noindex || !indexingAllowed;
const suffix = ` | ${settings.brand.short}`;
const fullTitle = rawTitle || title.length + suffix.length > 65 ? title : title + suffix;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site).href;
// Every page gets a share image (WhatsApp / Instagram / Facebook previews): its own photo, or the brand card.
const image = new URL(ogImage ?? '/og-default.png', Astro.site).href;
const imageAlt = ogImage ? ogImageAlt : `${settings.brand.name} (${settings.brand.short}): group trips from Hyderabad & Bangalore`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{robotsNoindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={`${settings.brand.name} (${settings.brand.short})`} />
<meta property="og:locale" content="en_IN" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
{!ogImage && <meta property="og:image:width" content="1200" />}
{!ogImage && <meta property="og:image:height" content="630" />}
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

{/* `<` escaped so CMS text can never close the script tag */}
{ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />)}
