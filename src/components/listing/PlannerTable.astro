---
/**
 * "Trip planner" comparison table generated from trip data (getting there, length, best
 * time, from-price). Genuinely useful on category pages and stays accurate automatically.
 */
import { getCollection } from 'astro:content';
import type { TripView } from '@/lib/catalog';
import { inr, durationLabel, bestMonthsLabel } from '@/lib/format';

interface Props {
  trips: TripView[];
  title?: string;
  headingLevel?: 'h2' | 'h3';
  max?: number;
  /** Departure city: price and link use that departure. */
  origin?: string;
}

const { trips, title = 'Trip planner', headingLevel = 'h2', max = 12, origin } = Astro.props;
const H = headingLevel;
const destinations = new Map((await getCollection('destinations')).map((d) => [d.id, d.data]));
const rows = trips.slice(0, max).map((t) => ({
  trip: t,
  travel: t.data.transportOptions[0].label,
  duration: durationLabel(t.data.durationNights, t.data.durationDays),
  best: bestMonthsLabel(destinations.get(t.data.destinations[0].id)?.bestMonths ?? []),
  from: ((origin && t.origins.find((o) => o.city === origin)) || t.primary).fromPrice,
  url: ((origin && t.origins.find((o) => o.city === origin)) || t.primary).url,
}));
---

{
  rows.length >= 2 && (
    <section class="planner" aria-labelledby="planner-title">
      <H id="planner-title" class="planner__title">
        {title}
      </H>
      <div class="planner__wrap">
        <table class="planner__table">
          <thead>
            <tr>
              <th scope="col">Trip</th>
              <th scope="col">Getting there</th>
              <th scope="col">Length</th>
              <th scope="col">Best time</th>
              <th scope="col">From</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <th scope="row">
                  <a href={r.url}>{r.trip.data.title}</a>
                </th>
                <td>{r.travel}</td>
                <td>{r.duration}</td>
                <td>{r.best || '—'}</td>
                <td class="num">{r.from != null ? inr(r.from) : 'On request'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )
}

<style>
  .planner__title {
    margin-bottom: var(--s-3);
    font-size: var(--fs-h3);
  }
  .planner__wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }
  .planner__table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .planner__table th,
  .planner__table td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    white-space: nowrap;
  }
  .planner__table thead th {
    background: var(--surface-2);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .planner__table tbody tr:last-child > * {
    border-bottom: 0;
  }
  .planner__table tbody th a {
    font-weight: 600;
    text-decoration: none;
  }
  .planner__table tbody th a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
