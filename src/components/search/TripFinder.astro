---
/**
 * Hero trip finder. A plain GET form to /trips/ (works without JS; native mobile
 * pickers). Month options come from months that actually have departures.
 * Fires GA4 `search` on submit.
 */
import { getCollection } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import { getUpcoming } from '@/lib/catalog';
import { monthLong } from '@/lib/format';
import { TRIP_TYPE_LINKS } from '@/data/navigation';

interface Props {
  layout?: 'stack' | 'row';
  id?: string;
  class?: string;
}

const { layout = 'stack', id = 'finder', class: className } = Astro.props;
const showSamples = import.meta.env.PUBLIC_SHOW_SAMPLES === 'true';

const upcoming = await getUpcoming();
const months = [...new Set(upcoming.map((u) => u.departure.start.slice(0, 7)))].slice(0, 6);
const destinations = (await getCollection('destinations')).filter((d) => showSamples || !d.data.sample).map((d) => d.data.name);
const suggestions = [...new Set([...destinations, ...TRIP_TYPE_LINKS.filter((t) => t.type !== 'custom').map((t) => t.label)])].sort();
const styles = [
  { value: 'weekend', label: 'Weekend getaway' },
  { value: 'trek', label: 'Trek & adventure' },
  { value: 'camping', label: 'Camping' },
  { value: 'long', label: 'Long trip' },
  { value: 'backpacking', label: 'Backpacking' },
];
---

<form class:list={['finder', `finder--${layout}`, className]} action="/trips/" method="get" role="search" aria-label="Find a trip" data-finder>
  <label class="finder__f finder__f--where" for={`${id}-q`}>
    <Icon name="search" />
    <span class="finder__txt">
      <span class="finder__lbl">Where to?</span>
      <input id={`${id}-q`} name="q" type="search" placeholder="Ooty, treks, camping…" list={`${id}-list`} autocomplete="off" enterkeyhint="search" />
    </span>
  </label>
  <datalist id={`${id}-list`}>{suggestions.map((s) => <option value={s} />)}</datalist>
  <span class="finder__sep" aria-hidden="true"></span>
  <label class="finder__f" for={`${id}-month`}>
    <Icon name="calendar" />
    <span class="finder__txt">
      <span class="finder__lbl">When?</span>
      <select id={`${id}-month`} name="month">
        <option value="">Any time</option>
        {upcoming.length > 0 && <option value="this-weekend">This weekend</option>}
        {upcoming.length > 0 && <option value="next-weekend">Next weekend</option>}
        {months.map((m) => <option value={m}>{monthLong(m)}</option>)}
      </select>
    </span>
  </label>
  <span class="finder__sep" aria-hidden="true"></span>
  <label class="finder__f" for={`${id}-style`}>
    <Icon name="compass" />
    <span class="finder__txt">
      <span class="finder__lbl">Travel style</span>
      <select id={`${id}-style`} name="style">
        <option value="">Any style</option>
        {styles.map((s) => <option value={s.value}>{s.label}</option>)}
      </select>
    </span>
  </label>
  <button type="submit" class="btn btn--primary btn--lg finder__go">Find My Trip</button>
</form>

<script>
  import { track } from '@/scripts/analytics';
  document.querySelectorAll<HTMLFormElement>('[data-finder]').forEach((form) => {
    // Drop empty params so URLs stay clean (/trips/?month=2026-10 instead of ?q=&month=2026-10&style=)
    form.addEventListener('submit', () => {
      const fd = new FormData(form);
      track('search', {
        search_term: String(fd.get('q') ?? ''),
        month: String(fd.get('month') ?? ''),
        trip_style: String(fd.get('style') ?? ''),
        cta_location: 'trip_finder',
      });
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[name]').forEach((el) => {
        if (!el.value) el.disabled = true;
      });
      setTimeout(() => form.querySelectorAll<HTMLInputElement>('[name]').forEach((el) => (el.disabled = false)), 0);
    });
  });
</script>

<style>
  .finder {
    display: grid;
    gap: 2px;
    padding: 8px;
    background: var(--surface);
    color: var(--ink-900);
    border-radius: var(--r-xl);
    box-shadow: var(--sh-3);
  }
  .finder__f {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 60px;
    padding: 8px 14px;
    border-radius: var(--r-lg);
    cursor: pointer;
    transition: background-color var(--t) var(--ease);
  }
  .finder__f:hover,
  .finder__f:focus-within {
    background: var(--surface-2);
  }
  .finder__f > :global(.icon) {
    color: var(--forest-500);
    font-size: 1.15rem;
  }
  .finder__txt {
    display: grid;
    flex: 1;
    min-width: 0;
  }
  .finder__lbl {
    margin-bottom: 2px;
    font: 600 0.6875rem / 1 var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .finder input,
  .finder select {
    width: 100%;
    min-height: 26px;
    padding: 0;
    border: 0;
    background: transparent;
    font: 600 1rem / 1.3 var(--font-body);
    color: var(--ink-900);
    appearance: none;
    outline: none;
    cursor: pointer;
  }
  .finder input::placeholder {
    color: var(--text-3);
    font-weight: 500;
  }
  .finder__sep {
    height: 1px;
    margin: 0 14px;
    background: var(--line);
  }
  .finder__go {
    margin: 4px;
  }

  /* Stack layout: When + Style side by side on phones */
  .finder--stack {
    grid-template-columns: 1fr 1fr;
  }
  .finder--stack .finder__f--where,
  .finder--stack .finder__sep:first-of-type,
  .finder--stack .finder__go {
    grid-column: 1 / -1;
  }
  .finder--stack .finder__sep:not(:first-of-type) {
    display: none;
  }

  @media (min-width: 900px) {
    .finder--row {
      grid-template-columns: 1.4fr auto 1fr auto 1fr auto;
      align-items: center;
      padding: 8px 8px 8px 10px;
      border-radius: var(--r-pill);
    }
    .finder--row .finder__f {
      border-radius: var(--r-pill);
    }
    .finder--row .finder__sep {
      width: 1px;
      height: 36px;
      margin: 0;
    }
    .finder--row .finder__go {
      margin: 0;
      border-radius: var(--r-pill);
    }
  }
</style>
