---
/**
 * Day-wise itinerary: one lead photo (the first itinerary photo that isn't the page's hero image, if any),
 * then every day as a plain text section (Day label, title, description, meals and stay), always visible
 * and crawlable. Per-day photos stay in the trip data but are not shown. Weekday labels come from the
 * next departure.
 */
import TripSection from './TripSection.astro';
import Icon from '@/components/ui/Icon.astro';
import Photo from '@/components/ui/Photo.astro';
import PhotoCredit from '@/components/ui/PhotoCredit.astro';
import type { TripView, TripOriginView } from '@/lib/catalog';
import { dayShort } from '@/lib/format';
import ConfirmText from '@/components/content/ConfirmText.astro';
import { waHref } from '@/lib/whatsapp';

interface Props {
  trip: TripView;
  origin: TripOriginView;
}

const { trip, origin } = Astro.props;
const confirmHref = waHref({ subject: trip.data.whatsappSubject, tripTitle: trip.data.title, originLabel: origin?.label });
const days = [...origin.itinerary].sort((a, b) => a.day - b.day);
const start = origin.next?.start;
const weekday = (offset: number) => {
  if (!start) return null;
  const d = new Date(`${start}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + offset);
  return dayShort(d.toISOString().slice(0, 10));
};
const firstDay = days[0]?.day ?? 0;
// Which itinerary day falls on the departure date: day 0 when the plan lists it; for an overnight journey
// that starts at day 1, day 1 is the morning after departure; otherwise day 1 is the departure date.
const departureDay = firstDay === 0 || origin.overnightTravel ? 0 : 1;
const MEAL: Record<string, string> = { breakfast: 'Breakfast', lunch: 'Lunch', dinner: 'Dinner', snacks: 'Snacks' };
const heroSrc = trip.data.heroImage?.src;
const lead = days.find((d) => d.image && d.image.src !== heroSrc);
---

{
  days.length > 0 && (
    <TripSection id="itinerary" title="Day-wise itinerary">
      {lead?.image && (
        <figure class="it__lead">
          <Photo src={lead.image} alt={lead.imageAlt ?? lead.title} sizes="(min-width: 1024px) 720px, 92vw" widths={[360, 560, 720, 1080]} />
          <PhotoCredit credit={lead.imageCredit} />
        </figure>
      )}
      <ol class="it">
        {days.map((day) => (
          <li class="it__day">
            <p class="it__num">
              Day {day.day}
              {weekday(day.day - departureDay) && <span> · {weekday(day.day - departureDay)}</span>}
            </p>
            <h3 class="it__title">{day.title}</h3>
            {day.start && (
              <p class="it__start">
                <Icon name="clock" /> {day.start}
              </p>
            )}
            {day.description && (
              <p class="it__text">
                <ConfirmText text={day.description} href={confirmHref} tripId={trip.id} />
              </p>
            )}
            {day.points.length > 0 && (
              <ul class="it__points">
                {day.points.map((pt) => (
                  <li>
                    <ConfirmText text={pt} href={confirmHref} tripId={trip.id} />
                  </li>
                ))}
              </ul>
            )}
            {(day.meals.length > 0 || day.stay) && (
              <p class="it__meta">
                {day.meals.length > 0 && (
                  <span>
                    <Icon name="food" /> {day.meals.map((m) => MEAL[m]).join(', ')}
                  </span>
                )}
                {day.stay && (
                  <span>
                    <Icon name="bed" /> {day.stay}
                  </span>
                )}
              </p>
            )}
          </li>
        ))}
      </ol>
    </TripSection>
  )
}

<style>
  .it__lead {
    position: relative;
    aspect-ratio: 16 / 7;
    margin: 0 0 var(--s-5);
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--surface-2);
  }
  .it {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Trail line down the left, one dot per day */
  .it::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: radial-gradient(circle, var(--line-strong) 1px, transparent 1.5px) 50% 0 / 2px 6px repeat-y;
  }
  .it__day {
    position: relative;
    padding-left: 28px;
  }
  .it__day::before {
    content: '';
    position: absolute;
    left: 0;
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--brand);
    box-shadow: 0 0 0 3px var(--surface);
  }
  .it__day + .it__day {
    margin-top: var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }
  .it__day + .it__day::before {
    top: calc(var(--s-5) + 5px);
  }
  .it__start {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 var(--s-2);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-2);
  }
  .it__start :global(.icon) {
    color: var(--forest-500);
  }
  .it__points {
    display: grid;
    gap: 6px;
    margin: var(--s-2) 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-700);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .it__points li {
    position: relative;
    padding-left: 16px;
  }
  .it__points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--forest-500);
  }
  .it__num {
    margin: 0;
    color: var(--forest-700);
    font: 800 0.75rem / 1.2 var(--font-body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .it__num span {
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-2);
  }
  .it__title {
    margin: 4px 0 var(--s-2);
    font: 700 1.0625rem / 1.3 var(--font-display);
  }
  .it__text {
    margin: 0;
    color: var(--ink-700);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .it__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: var(--s-2) 0 0;
    font-size: 0.8125rem;
    color: var(--text-2);
  }
  .it__meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .it__meta :global(.icon) {
    color: var(--forest-500);
  }
</style>
