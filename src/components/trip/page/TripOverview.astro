---
/** Overview: the trip's unique story (markdown body) + highlights checklist. */
import { getCollection, getEntry, render } from 'astro:content';
import TripSection from './TripSection.astro';
import Icon from '@/components/ui/Icon.astro';
import { destinationUrl, type TripView, type TripOriginView } from '@/lib/catalog';

interface Props {
  trip: TripView;
  origin?: TripOriginView;
}

const { trip, origin } = Astro.props;
const { Content } = await render(trip.entry);
const hasBody = !!trip.entry.body?.trim();
// Link to destination guides that are approved for Google (Phase A internal linking).
const guides = (await Promise.all(trip.data.destinations.map((r) => getEntry(r)))).filter((e) => e && e.data.indexable && e.data.seoTier !== 'c');
// Up-link to this city's indexable hub (Bangalore's hub is on hold, so it isn't linked here).
const HUBS: Record<string, Record<string, { label: string; href: string }>> = {
  hyderabad: {
    camping: { label: 'More camping near Hyderabad', href: '/camping-near-hyderabad/' },
    weekend: { label: 'More weekend trips from Hyderabad', href: '/weekend-trips-from-hyderabad/' },
  },
};
const cityHubs = origin ? HUBS[origin.city] : undefined;
// The trip's main type decides the hub (same rule as the breadcrumb): Gokarna–Dandeli is a weekend trip with camp nights.
const hubType = trip.data.tripTypes.find((t) => cityHubs?.[t]);
const hub = hubType ? cityHubs![hubType] : undefined;
// A more specific landing for this trip's destination and type (e.g. the Ananthagiri Hills campsite comparison).
const destIds = trip.data.destinations.map((x) => x.id);
const compare = origin
  ? (await getCollection('landings', (l) => !l.data.sample)).find(
      (l) =>
        l.data.path !== hub?.href &&
        l.data.rule.destinations?.some((x) => destIds.includes(x.id)) &&
        (!l.data.rule.tripTypes?.length || l.data.rule.tripTypes.some((t) => trip.data.tripTypes.includes(t))) &&
        (!l.data.rule.origin || l.data.rule.origin === origin.city),
    )
  : undefined;
---

<TripSection id="overview" title="Overview">
  {
    hasBody && (
      <div class="ov__body prose">
        <Content />
      </div>
    )
  }
  {
    trip.data.highlights.length > 0 && (
      <>
        <h3 class="ov__h3">Highlights</h3>
        <ul class="ov__hl">
          {trip.data.highlights.map((h) => (
            <li>
              <Icon name="check" />
              {h}
            </li>
          ))}
        </ul>
      </>
    )
  }
  {
    (guides.length > 0 || hub || compare) && (
      <p class="ov__guides">
        Plan your visit:{' '}
        {guides.map((g, i) => (
          <>
            {i > 0 && ' · '}
            <a href={destinationUrl(g!.id)}>{g!.data.name} travel guide</a>
          </>
        ))}
        {compare && (
          <>
            {guides.length > 0 && ' · '}
            <a href={compare.data.path}>Compare: {compare.data.title}</a>
          </>
        )}
        {hub && (
          <>
            {(guides.length > 0 || compare) && ' · '}
            <a href={hub.href}>{hub.label}</a>
          </>
        )}
      </p>
    )
  }
</TripSection>

<style>
  .ov__body {
    max-width: 68ch;
    color: var(--ink-700);
    font-size: 1.0625rem;
  }
  .ov__body :global(p + p) {
    margin-top: var(--s-4);
  }
  .ov__body :global(strong) {
    color: var(--ink-900);
  }
  .ov__guides {
    margin-top: var(--s-5);
    font-size: 0.9375rem;
    color: var(--text-2);
  }
  .ov__h3 {
    margin: var(--s-6) 0 var(--s-3);
    font-size: 1.125rem;
  }
  .ov__hl {
    display: grid;
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ov__hl li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .ov__hl :global(.icon) {
    margin-top: 3px;
    color: var(--forest-500);
  }
  @media (min-width: 768px) {
    .ov__hl {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
