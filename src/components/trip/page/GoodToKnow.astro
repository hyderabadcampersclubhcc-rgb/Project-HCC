---
/**
 * Good to know: who it's for / not for, things to carry, important notes, and a
 * payment & cancellation summary (link to the full policy). Each block renders only with data.
 */
import TripSection from './TripSection.astro';
import Icon from '@/components/ui/Icon.astro';
import type { TripView, TripOriginView } from '@/lib/catalog';
import { settings } from '@/lib/settings';
import { waHref, waRef } from '@/lib/whatsapp';
import ConfirmText from '@/components/content/ConfirmText.astro';
import WhatsAppCTA from '@/components/cta/WhatsAppCTA.astro';
import { paymentLines, summaryLines } from '@/lib/cancellation';

interface Props {
  trip: TripView;
  /** Departure city: its own packing list and notes, falling back to the trip's. */
  origin?: TripOriginView;
}

const { trip, origin } = Astro.props;
const d = trip.data;
const thingsToCarry = origin?.thingsToCarry ?? d.thingsToCarry;
const importantInfo = origin?.importantInfo ?? d.importantInfo;
const toConfirm = d.confirmOnWhatsApp;
const terms = d.paymentTerms;
// Every trip shows the shared Cancellation & Refund Policy (src/data/cancellation-policy.json) with its own advance lines.
const payment = paymentLines(trip.id);
const hasPayment = true;
const phone = settings.contact.phone || settings.contact.whatsapp;
const tel = phone ? `tel:+${phone.replace(/\D/g, '').replace(/^(?!91)(\d{10})$/, '91$1')}` : null;
// Unconfirmed details link to HCC's WhatsApp with this trip's message (tracked like every WhatsApp CTA).
const confirmHref = waHref({ subject: d.whatsappSubject, tripTitle: d.title, originLabel: origin?.label });
const any =
  d.suitableFor.length || d.notSuitableFor.length || thingsToCarry.length || importantInfo.length || hasPayment || d.infoSections.length || d.contactCard;
---

{
  any && (
    <TripSection id="info" title="Good to know">
      <div class="gtk">
        {(d.suitableFor.length > 0 || d.notSuitableFor.length > 0) && (
          <div class="gtk__card gtk__card--wide">
            <div class="gtk__fit">
              {d.suitableFor.length > 0 && (
                <div>
                  <h3>Great for</h3>
                  <ul class="gtk__tags">
                    {d.suitableFor.map((s) => (
                      <li class="gtk__tag gtk__tag--yes">{s}</li>
                    ))}
                  </ul>
                </div>
              )}
              {d.notSuitableFor.length > 0 && (
                <div>
                  <h3>Not ideal for</h3>
                  <ul class="gtk__tags">
                    {d.notSuitableFor.map((s) => (
                      <li class="gtk__tag">{s}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        )}
        {thingsToCarry.length > 0 && (
          <div class="gtk__card">
            <h3>
              <Icon name="backpack" /> Things to carry
            </h3>
            <ul class="gtk__list">
              {thingsToCarry.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
        )}
        {importantInfo.length > 0 && (
          <div class="gtk__card">
            <h3>
              <Icon name="info" /> Important
            </h3>
            <ul class="gtk__list">
              {importantInfo.map((t) => (
                <li>
                  <ConfirmText text={t} href={confirmHref} tripId={trip.id} />
                </li>
              ))}
            </ul>
          </div>
        )}
        {d.infoSections.map((s) => (
          <div class="gtk__card gtk__card--wide">
            <h3>
              <Icon name="info" /> {s.title}
            </h3>
            <ul class="gtk__list">
              {s.points.map((t) => (
                <li>
                  <ConfirmText text={t} href={confirmHref} tripId={trip.id} />
                </li>
              ))}
            </ul>
          </div>
        ))}
        {hasPayment && (
          <div class="gtk__card gtk__card--wide" id="policies">
            <h3>
              <Icon name="shield" /> Payment & cancellation
            </h3>
            <ul class="gtk__list">
              {payment.map((t) => (
                <li>
                  <ConfirmText text={t} href={confirmHref} tripId={trip.id} />
                </li>
              ))}
              {terms.map((t) => (
                <li>{t}</li>
              ))}
              <li>{settings.payments.enabled ? 'The advance is paid securely online.' : 'The HCC team confirms your seat and shares payment details.'}</li>
              {d.gstPercent != null && <li>GST of {d.gstPercent}% applies and is shown in the price summary.</li>}
              {summaryLines().map((t) => (
                <li>{t}</li>
              ))}
              {toConfirm.map((label) => (
                <li>
                  <b>{label}:</b>{' '}
                  {confirmHref ? (
                    <a href={confirmHref} target="_blank" rel="noopener" data-wa data-wa-ref={waRef(trip.id)} data-cta-location="confirm_details" data-trip-id={trip.id}>
                      Contact us on WhatsApp to confirm.
                    </a>
                  ) : (
                    'Contact us on WhatsApp to confirm.'
                  )}
                </li>
              ))}
            </ul>
            <a class="btn btn--text gtk__more" href="/cancellation-policy/">
              Read the full cancellation policy <Icon name="arrow" />
            </a>
          </div>
        )}
        {d.contactCard && phone && (
          <div class="gtk__card gtk__card--wide gtk__contact">
            <h3>
              <Icon name="whatsapp" /> Call / WhatsApp
            </h3>
            <p>
              <a href={tel ?? undefined} data-cta-location="trip_contact_call">
                {phone}
              </a>
            </p>
            <WhatsAppCTA location="trip_contact" tripId={trip.id} context={{ subject: d.whatsappSubject, tripTitle: d.title, originLabel: origin?.label }} size="sm" />
          </div>
        )}
      </div>
    </TripSection>
  )
}

<style>
  .gtk {
    display: grid;
    gap: var(--s-3);
  }
  .gtk__card {
    padding: var(--s-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .gtk__card h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--s-3);
    font-size: 1rem;
  }
  .gtk__card h3 :global(.icon) {
    color: var(--forest-500);
  }
  .gtk__fit {
    display: grid;
    gap: var(--s-5);
  }
  .gtk__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gtk__tag {
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: var(--surface-2);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .gtk__tag--yes {
    background: var(--ok-bg);
    color: var(--forest-700);
  }
  .gtk__list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-left: 18px;
    font-size: 0.9375rem;
    color: var(--ink-700);
  }
  .gtk__more {
    margin-top: var(--s-3);
    font-size: 0.875rem;
  }
  .gtk__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
  }
  .gtk__contact h3 {
    margin: 0;
  }
  .gtk__contact p {
    margin: 0;
    font-weight: 700;
  }
  @media (min-width: 768px) {
    .gtk {
      grid-template-columns: 1fr 1fr;
    }
    .gtk__card--wide {
      grid-column: 1 / -1;
    }
    .gtk__fit {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
