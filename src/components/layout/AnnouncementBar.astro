---
/** Editable in CMS (Site settings → Announcement). Auto-hides outside its date window. */
import { activeAnnouncement } from '@/lib/settings';

const a = activeAnnouncement();
const Tag = a?.url ? 'a' : 'p';
---

{
  a && (
    <Tag class="ann" href={a.url || undefined} data-track={a.url ? 'select_promotion' : undefined} data-cta-location="announcement">
      <span>{a.text}</span>
      {a.url && a.linkText && <b>{a.linkText} →</b>}
    </Tag>
  )
}

<style>
  .ann {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 2px 8px;
    min-height: 38px;
    margin: 0;
    padding: 8px var(--gutter);
    background: var(--brand-deep);
    color: var(--white);
    font: 500 0.8125rem / 1.3 var(--font-body);
    text-align: center;
    text-decoration: none;
  }
  .ann b {
    color: var(--cta);
    font-weight: 600;
    white-space: nowrap;
  }
  a.ann:hover b {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
