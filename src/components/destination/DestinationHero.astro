---
/**
 * Destination hero. H1 "{Name} Trips from Hyderabad" owns the commercial destination
 * search ("ooty tour packages from hyderabad"); the trip page owns the trip-specific one.
 */
import type { ImageMetadata } from 'astro';
import Photo, { type Tone } from '@/components/ui/Photo.astro';
import Breadcrumbs from '@/components/content/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import WhatsAppCTA from '@/components/cta/WhatsAppCTA.astro';
import { inr } from '@/lib/format';

interface Props {
  name: string;
  summary: string;
  image?: ImageMetadata;
  imageAlt?: string;
  tone?: Tone;
  tripCount: number;
  fromPrice?: number | null;
  preview?: boolean;
}

const { name, summary, image, imageAlt, tone = 'hills', tripCount, fromPrice, preview = false } = Astro.props;
---

<section class="dhero" aria-labelledby="dhero-title">
  <Photo src={image} alt={imageAlt ?? `${name} trips from Hyderabad`} tone={tone} eager sizes="100vw" widths={[480, 768, 1080, 1440, 1920]} label={preview && !image ? `${name} hero photo` : undefined} class="dhero__photo" />
  <div class="container dhero__in">
    <Breadcrumbs items={[{ label: 'Destinations', href: '/destinations/' }, { label: name }]} onDark />
    <h1 id="dhero-title" class="dhero__title">{name} Trips from Hyderabad</h1>
    <p class="dhero__sum">{summary}</p>
    <p class="dhero__meta">
      {tripCount > 0 ? `${tripCount} trip${tripCount > 1 ? 's' : ''}` : 'Custom trips on request'}
      {fromPrice != null && <> · from <b>{inr(fromPrice)}</b> per person</>}
    </p>
    <div class="dhero__cta">
      {tripCount > 0 && <Button href="#trips">View {name} Trips</Button>}
      <WhatsAppCTA location="destination_hero" variant="ghost" context={{ destination: name }} label={`Ask about ${name}`} />
    </div>
  </div>
</section>

<style>
  .dhero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: min(78svh, 600px);
    padding-block: var(--s-16) var(--s-8);
    color: var(--white);
    background: var(--brand-deep);
  }
  .dhero > :global(.dhero__photo) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .dhero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(10 20 16 / 0.85) 0%, rgb(10 20 16 / 0.3) 50%, rgb(10 20 16 / 0.15) 100%);
  }
  .dhero__in {
    display: grid;
    gap: var(--s-3);
  }
  .dhero__title {
    max-width: 16ch;
    font-size: var(--fs-display);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }
  .dhero__sum {
    max-width: 52ch;
    font-size: var(--fs-lg);
    color: rgb(255 255 255 / 0.9);
  }
  .dhero__meta {
    font-size: 0.9375rem;
    color: rgb(255 255 255 / 0.85);
  }
  .dhero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-2);
  }
</style>
