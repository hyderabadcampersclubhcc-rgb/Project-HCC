---
/** Trips visiting a destination (from the catalog), with a custom-trip fallback when none exist. */
import TripCard from '@/components/trip/TripCard.astro';
import WhatsAppBand from '@/components/cta/WhatsAppBand.astro';
import { getTripsForDestination } from '@/lib/catalog';

interface Props {
  id: string;
  name: string;
  catalog?: { samples?: boolean; today?: string };
}

const { id, name, catalog = {} } = Astro.props;
const trips = await getTripsForDestination(id, catalog);
// Group by departure city (Hyderabad first, then Bangalore, then the rest), one card per trip per city.
const ORDER = ['hyderabad', 'bangalore'];
const cities = [...new Map(trips.flatMap((t) => t.origins.map((o) => [o.city, o.label] as const))).entries()].sort(
  (a, b) => (ORDER.indexOf(a[0]) + 1 || 99) - (ORDER.indexOf(b[0]) + 1 || 99),
);
const groups = cities.map(([city, label]) => ({ city, label, trips: trips.filter((t) => t.origins.some((o) => o.city === city)) }));
const single = groups.length === 1;
---

<section id="trips" class="dtrips" aria-labelledby="dtrips-title">
  <h2 id="dtrips-title" class="dtrips__title">
    {trips.length ? (single ? `${name} trips from ${groups[0].label}` : `HCC trips to ${name}`) : `Plan a trip to ${name}`}
  </h2>
  {
    trips.length > 0 ? (
      groups.map((g) => (
        <>
          {!single && <h3 class="dtrips__city">From {g.label}</h3>}
          <div class="rail rail--grid" style="--rail-cols:3">
            {g.trips.map((t, i) => (
              <TripCard trip={t} origin={g.city} index={i} listName={`destination_${id}_${g.city}`} />
            ))}
          </div>
        </>
      ))
    ) : (
      <WhatsAppBand
        location="destination_no_trips"
        title={`No fixed ${name} departures right now`}
        text={`We can plan a ${name} trip around your dates and group. Tell us what you have in mind.`}
        context={{ destination: name }}
        headingLevel="h3"
      />
    )
  }
</section>

<style>
  .dtrips__city {
    margin: var(--s-6) 0 var(--s-3);
    font-size: 1.125rem;
  }
  .dtrips {
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .dtrips__title {
    margin-bottom: var(--s-5);
    font-size: var(--fs-h2);
  }
</style>
